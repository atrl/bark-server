BARK_IMAGE=bark-server:REPLACE_WITH_COMMIT
BARK_PUBLIC_URL=https://bark.example.com
# Keep these empty until the matching Firebase project is provisioned.
BARK_FCM_PROJECT_ID=
BARK_FCM_CREDENTIALS_PATH=
# Optional private loopback proxy, e.g. http://127.0.0.1:17890.
BARK_HTTPS_PROXY=

# APK mirror has an independent outbound proxy setting.
BARK_RELEASE_HTTPS_PROXY=http://127.0.0.1:17890
