BARK_IMAGE=bark-server:REPLACE_WITH_COMMIT
BARK_PUBLIC_URL=https://bark.example.com
# Keep these empty until the matching Firebase project is provisioned.
BARK_FCM_PROJECT_ID=
BARK_FCM_CREDENTIALS_PATH=
# Existing NAS main Clash HTTP proxy. Leave empty only when direct access works.
BARK_HTTPS_PROXY=http://127.0.0.1:7890

# APK mirror uses the same NAS proxy; this override remains independently configurable.
BARK_RELEASE_HTTPS_PROXY=http://127.0.0.1:7890
